{
  "expo": {
    "name": "cide",
    "slug": "cide-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "cide",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "dev.cide.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#0d1117"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "cide uses the camera to scan pairing codes and take photos you choose to attach to a console.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/monochrome-icon.png",
          "color": "#e76831"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "cide uses photos you select to attach images to a console on your computer.",
          "cameraPermission": "cide uses the camera to scan pairing codes and take photos you choose to attach to a console.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
